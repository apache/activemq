<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://www.eclipse.org/jetty/configure_10_0.dtd">

<!-- Prometheus metrics web application (activemq-prometheus).
    Mounts the metrics endpoint at /metrics on the web console listener.
    Add this file to jettyExtraXmlFiles in conf/jetty-spring.properties and restart the broker.
    Access follows the catch-all /* rule in jetty-security.xml (users and admins).
    Add a /metrics/* rule there to restrict it further. -->
<Configure class="org.eclipse.jetty.server.handler.ContextHandlerCollection" id="Contexts">

  <Call name="addHandler">
    <Arg>
      <New class="org.eclipse.jetty.ee11.webapp.WebAppContext">
        <Set name="contextPath">/metrics</Set>
        <Set name="baseResourceAsString"><Property name="activemq.home" default="."/>/webapps/metrics</Set>
        <Set name="logUrlOnStart">true</Set>
        <!-- Destination types reported by /metrics?per_object=true.
            Comma separated list of: queue, topic, temp-queue, temp-topic.
            Default: queue,topic
        <Call name="setInitParameter">
          <Arg>destinationTypes</Arg>
          <Arg>queue,topic,temp-queue,temp-topic</Arg>
        </Call>
        -->
      </New>
    </Arg>
  </Call>

</Configure>
