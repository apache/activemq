<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.activemq</groupId>
  <artifactId>activemq-website</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>activemq-website</name>
  <url>https://activemq.apache.org/</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>2.0.1</version>
        <configuration>
          <workingDirectory>website</workingDirectory>
          <nodeVersion>v22.16.0</nodeVersion>
          <environmentVariables>
            <CI>true</CI>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <id>pnpm clear</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <phase>clean</phase>
            <configuration>
              <arguments>run clear</arguments>
            </configuration>
          </execution>
          <execution>
            <id>install pnpm</id>
            <goals>
              <goal>install-node-and-pnpm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <pnpmVersion>11.9.0</pnpmVersion>
            </configuration>
          </execution>
          <execution>
            <id>pnpm install</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>
          <execution>
            <id>pnpm run build</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
          <execution>
            <id>start</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <phase>none</phase>
            <configuration>
              <arguments>start</arguments>
            </configuration>
          </execution>
          <execution>
            <id>start-search</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <phase>none</phase>
            <configuration>
              <arguments>run start:search</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-website</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/website</outputDirectory>
              <resources>
                <resource>
                  <directory>website/build</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
